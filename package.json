{
  "name": "temp_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "classroom": "npm run build && node scripts/classroom.mjs",
    "build": "wrangler types worker/runtime.d.ts --include-env=false && tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run build && node --test \"worker/tests/*.test.mjs\"",
    "deploy": "npm run build && wrangler deploy",
    "tester": "node scripts/tester.mjs",
    "check:studio": "node scripts/check-studio.mjs",
    "check:themes": "node scripts/check-theme-browser.mjs",
    "check:missions": "node scripts/check-mission-studio.mjs",
    "check:missions:browser": "node scripts/check-mission-browser.mjs",
    "check:announcements:browser": "node scripts/check-announcements-browser.mjs",
    "check:teacher-guide": "node scripts/check-teacher-guide.mjs",
    "check:teacher-character": "node scripts/check-teacher-character.mjs",
    "check:report-feedback": "node scripts/check-report-feedback.mjs",
    "check:activity-history": "node scripts/check-activity-history.mjs",
    "check:warmups": "node scripts/check-warmup-studio.mjs",
    "theme": "node scripts/install-theme.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "nspell": "^2.1.5",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260923.1": true
  }
}
