{
  "name": "temp_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "classroom": "npm run build && node scripts/classroom.mjs",
    "build": "wrangler types worker/runtime.d.ts --include-env=false && tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run build && node --test \"worker/tests/*.test.mjs\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.140.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260923.1": true
  }
}
