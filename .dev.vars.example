# Copy to .dev.vars for `npm run dev:worker`. Never commit .dev.vars.
# lowercase-hex SHA-256 of the NFC-normalised teacher password, the same scheme as PinPlay:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1].trim().normalize('NFC')).digest('hex'))" "your password"
CREATE_PASSWORD_HASH=
# Local only: reach PinPlay over HTTPS instead of the service binding.
PINPLAY_API_URL=https://api.pinplay.win
# Optional: also check every message with OpenAI's moderation. Online, set it with `npx wrangler secret put OPENAI_API_KEY`.
# Without it, only the word filter and the teacher check messages.
OPENAI_API_KEY=
# Optional: the chat model that gives grammar hints (default gpt-4o-mini).
# OPENAI_GRAMMAR_MODEL=
# Optional: override PinPlay's existing Render Edge TTS bridge for chat voices.
# EDGE_TTS_URL=https://pinplay-tts-bridge-27sk.onrender.com/tts
# EDGE_TTS_SECRET=
